# Copy to gateway/.env (local dev) or /etc/fashion-gateway.env (server). Never commit the real file.

# ComfyUI, only reachable from the server itself.
COMFY_URL=http://127.0.0.1:8188

# Body templates generated by the template script: <TEMPLATES_DIR>/<body>/<view>_guide.png etc.
TEMPLATES_DIR=/home/dct/ComfyUI/output/templates

# Where designs, sketches, renders and job state are stored.
DATA_DIR=/home/dct/fashion-data

# Comma-separated bearer tokens accepted by the API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKENS=change-me

# Public URL of the gateway (used to build absolute image URLs).
PUBLIC_BASE_URL=https://fashion-api.ucu-dct.org

# Extra CORS origins (comma list). Capacitor and Next dev origins are always allowed.
# CORS_ORIGINS=

# Upload limit per image in MB.
# MAX_UPLOAD_MB=15
